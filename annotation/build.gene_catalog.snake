            "benchmarks/all_genes.faa.{cluster_suffix}.ffn.time"
        shell: "screen_list.py -l {input[0]} -k {input[1]} > {output}"

## We also need to collect the contig coverages
rule assembly_gene_coverages:
    """
    For each assembly:
        map contig coverage onto individual genes
        normalize by total raeds in assembly
    """
    input:
        contig_covs=get_assembly_coverage_files,
        report=get_assembly_report_file,
        genes=lambda w: gene_call_files['faa'][w.assembly],
    output:
        table=temp('coverages/{assembly}.coverages.tsv'),
    benchmark: 'benchmarks/{assembly}.coverages.time'
    resources:
        disk=1
    run:
        # get number of reads in assembly
        # (divide by 1e9 so final data is in coverage per billion reads)
        read_counts = 0
        with open(str(input.report)) as lines:
            line_iter = iter(lines)
            line = next(line_iter)
            while not line.strip().startswith('reads:'):
                line = next(line_iter)

            for line in line_iter:
                if line.lstrip().startswith("###"):
                    break
                m = re.search(
                    r'^\s*(\S+)\s+clean\s+reads:\s*(\d+)',
                    line,
                )
                if m:
                    sample, read_count = m.groups()
                    read_counts += int(read_count)

        if read_counts == 0:
            ## something went wrong!
            print("report files: " + repr(input.report))
            raise Exception("No read counts found for assembly: " + \
                            str(wildcards.assembly))

        # get dict of contig coverages
        coverages = None
        coverages_per_bil = None
        if len(input.contig_covs) == 0:
            raise Exception("Cannot find coverage file for " +
                            assembly_path)
        contig_col = config.get('contig_col', 'Contig')
        cov_col = config.get('cov_col', 'MeanCov')
        for cov_file in input.contig_covs:
            _coverages = pandas.read_csv(cov_file,
                                         sep='\t',
                                         index_col=0,
                                         header=0,
                                         usecols=[contig_col, cov_col],
                                        )[cov_col]
            if coverages is None:
                coverages = _coverages
                coverages_per_bil = _coverages / read_counts
            else:
                coverages = coverages + _coverages
                coverages_per_bil = coverages_per_bil + _coverages / read_counts

        # transfer contig coverages to genes
        contig_rexp = re.compile(r'_\d+$')
        def get_gene_cov(gene, covs):
            " get contig name from gene and look up cov "
            return covs.get(contig_rexp.sub('', gene), 0)

        if len(coverages) == 0 or os.path.getsize(input.genes) == 0:
            # there is no data in this sample!
            with open(output.table, 'wt') as dummy_table:
                dummy_table.write(""",Coverage\n""")
        else:
            gene_coverages = \
                pandas.DataFrame(
                    {gene.id:{'Coverage':get_gene_cov(gene.id, coverages_per_bil),
                             } \
                              for gene in SeqIO.parse(input.genes, 'fasta')}
                ).T
            gene_coverages.query("Coverage > 0").to_csv(output.table)

rule gene_coverage_table:
    """
    collect assembly gene coverages
    use clusters to combine into one big coverage table for clusters

    This rule now outputs the table in "long" or "COO" format that is more
    efficient for sparse matrices. The gene_coverage_table_wide rule
    converts it to the traditional "wide" table.

    NOTE: the "sums" output is a total of normalized coverages. It's a proxy
    for overall abundance of each gene familiy but is dependent on the wieghts
        we apply to each sample.
    """
    input: 
        gene_covs=expand('coverages/{assembly}.coverages.tsv',
                         assembly=gene_call_files['faa']),
        clusters=prefix + ".clusters"
    output:
        table='{}.sample.coverage.tsv'.format(prefix),
        sums=temp('{}.coverage.tsv'.format(prefix))
    resources:
        disk=1
    benchmark: 'benchmarks/{}.sample.coverage.tsv.time'.format(prefix)
    run:
        # old way: merge into a "wide" format table
        #gene_cov_dict = {a:'coverages/{}.coverages.tsv'.format(a) \
        #                 for a in gene_call_files['faa']}
        #coverages = merge_cluster_coverages(input.clusters,
        #                                    gene_cov_dict)
        #coverages.to_csv(output.table)
        #coverages.sum(axis=1).to_csv(output.sums)

        # new way: "long" format requires no merging, just concatenation
        cluster_map = parse_clusters(input.clusters)

        rep_sums = {}
        with open(output.table, 'wt') as out_table:
            for assembly in gene_call_files['faa']:
                asm_path = unquote_plus(assembly)
                asm_cov_file = f'coverages/{assembly}.coverages.tsv'
                asm_covs = pandas.read_csv(asm_cov_file, index_col=0)
                asm_covs['cl_rep'] = [ \
                    cluster_map.get(g, g) \
                    for g in asm_covs.index \
                ]
                asm_sums = asm_covs.groupby('cl_rep').agg(sum)
                for rep, cov_norm in asm_sums.reset_index().values:
                    out_table.write(f'{asm_path}\t{rep}\t{cov_norm}\n')
                    rep_sums[rep] = rep_sums.get(rep, 0) + cov_norm

        with open(output.sums, 'wt') as out_table:
            for cl_rep, cov_sum in rep_sums.items():
                out_table.write(f'{cl_rep}\t{cov_sum}\n')


def get_wide_from_long_sparse(long_df, index=None, columns=None, values=None):
    """ Turn a long format DataFrame into a sparse wide format DataFrame 
        By default, the first column holds column names and the second hold row  names
          and the 3rd column holds cell values

        This is similar to the pivot() operation, but will work on large spase
        datasets that might otherwise overflow.
    """
    from scipy import sparse
    if index is None:
        index = long_df.columns[1]
    if columns is None:
        columns = long_df.columns[0]
    if values is None:
        values = long_df.columns[2]

    # enumerate unique row and column names
    rows = tuple(set(long_df[index].values))
    cols = tuple(set(long_df[columns].values))
    row_idxs = {g:i for i,g in enumerate(rows)}
    col_idxs = {g:i for i,g in enumerate(cols)}
    
    # translate Nx3 table into 3 indexed lists (needed for COO instantiation)
    I, J, data = zip(*((row_idxs[s], col_idxs[g], v) 
                       for s, g, v
                       in long_df[[index, columns, values]].values
                      )
                    )
    
    # make COO sparse matrix
    smat = sparse.coo_matrix((data, (I, J)), 
                             shape=(len(rows), len(cols))
                            )
    
    # make DataFrame from sparse matrix
    return pandas.DataFrame.sparse.from_spmatrix(smat, columns=cols, index=rows)

rule gene_coverage_table_wide:
    """
    convert the "long" format coverage table into "wide" format
    """
    input: 
        long='{}.sample.coverage.tsv'.format(prefix)
    output:
        wide='{}.sample.coverage.wide.tsv'.format(prefix)
    resources:
        disk=1
    benchmark:
        'benchmarks/{}.sample.coverage.wide.tsv.time'.format(prefix)
    run:
        # load the long format table
        df_long = pandas.read_csv( \
            'all_genes.clustered.sample.coverage.tsv', \
            sep='\t',  \
            names=['assembly', 'cluster', 'abundance'], \
            header=None, \
            index_col=None, \
        )

        df_wide = get_wide_from_long_sparse(df_long)

        df_wide.to_csv(output.wide, sep='\t')
 
## Collect per-assembly stats into a big table
import subprocess
import io

REPORT_TO_YAML_TEMPLATE="""
N=$(grep -n -m 1 "^#" {report_file} | perl -pe 's/:#.+//')
let N=N-1
head -n $N {report_file}
"""

def parse_report_file(report_file):
    # read the first N lines of the report file as YAML
    cmd = REPORT_TO_YAML_TEMPLATE.format(report_file=report_file)
    p = subprocess.run(cmd, shell=True, capture_output=True)
    report_data = yaml.load(io.BytesIO(p.stdout), yaml.SafeLoader)

    # it should be a dict with 3 entries
    assert 'all_contigs' in report_data
    assert isinstance(report_data['all_contigs'], dict)
    assert 'filtered_contigs' in report_data
    assert isinstance(report_data['filtered_contigs'], dict)
    assert 'reads' in report_data
    assert isinstance(report_data['reads'], dict)
    
    # let's return a dict with:
    
    #  - all_contigs data as is
    all_data = dict(report_data['all_contigs'])

    #  - filtered_contigs data prefixed with "filter_"
    all_data.update(
        ("filtered_" + key, value)
        for key, value in  report_data['filtered_contigs'].items()
    )
    
    #  - read and base totals from `reads`
    counts = Counter()
    for key, value in report_data['reads'].items():
        m = re.search(
            r'.+(clean|raw)\s+(?:R[12]\s+)?(reads|bases)',
            key
        )
        assert m is not None
        state, unit = m.groups()
        counts[f'{state}_{unit}'] += value
        # count clean reads entries to get the number of runs in assembly
        if state == 'clean' and unit == 'reads':
            counts['seq_runs'] += 1
    all_data.update(counts)

    return all_data

rule assembly_stats:
    input:
        reports=[unquote_plus(assembly) + "/contigs.report" \
                 for assembly in gene_call_files['faa']]
    output: prefix + '.reports.tsv'
    resources:
        disk=1
    run:
        report_df = pandas.DataFrame(
                {os.path.dirname(r):parse_report_file(r)
                 for r in input.reports}
        ).T
        report_df.index.name = 'assembly_dir'
        report_df['sample'] = [os.path.basename(ad) for ad in report_df.index]
        report_df.to_csv(str(output), sep='\t')

