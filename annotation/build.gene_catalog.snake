elif cluster_type == "faa":
    rule get_cluster_rep_ffn:
        input:
            "all_genes.faa.{cluster_suffix}.faa.idlist",
            "all_genes.ffn"
        output:
            "all_genes.faa.{cluster_suffix}.ffn"
        resources:
            disk=1
